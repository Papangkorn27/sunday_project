# Project database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sunday_assignment
POSTGRES_USER=sunday
POSTGRES_PASSWORD=change_me_project_password

# Postgres superuser used only by the container init script
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_password

# Airflow metadata database, isolated from project tables
AIRFLOW_DB=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db_password

# Airflow UI login
AIRFLOW_UID=50000
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change_me_airflow_ui_password
AIRFLOW_FIRSTNAME=Sunday
AIRFLOW_LASTNAME=Admin
AIRFLOW_EMAIL=admin@example.com

# Airflow runtime
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_WEB_PORT=8080
AIRFLOW_SECRET_KEY=change_me_airflow_secret_key
